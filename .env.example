# Copied to .env by ./run.sh with a random DB password. Never commit .env.
POSTGRES_USER=hvtradingbot
POSTGRES_DB=hvtradingbot
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433
# Dashboard/API port.
API_PORT=5080

# Broker: Deriv (demo account, default) or Paper (local simulated fills).
BROKER_PROVIDER=Deriv
# Market data: Deriv (real prices, default) or Simulated (offline synthetic feed; required when there is no network).
MARKET_DATA_PROVIDER=Deriv
# News and economic calendar: Public (free, keyless feeds, default), Simulated (offline) or None.
NEWS_PROVIDER=Public

# Deriv credentials are normally entered on the dashboard's Settings tab (stored encrypted in PostgreSQL).
# These optional variables are a fallback used only when nothing is saved there. Only the worker receives them.
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_ACCOUNT_ID=

# Optional fallback for email notifications; normally configured under Settings -> Notifications.
# Use a Gmail App Password, never your account password.
Notifications__Email__Enabled=false
Notifications__Email__Username=
Notifications__Email__Password=
Notifications__Email__ToAddresses__0=
