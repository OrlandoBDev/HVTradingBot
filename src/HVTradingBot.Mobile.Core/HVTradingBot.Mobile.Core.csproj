<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the Android app runs, without any Android dependency: the trading engine (restarted when it stops), the
    dashboard's reads and actions behind an in-process request router, and live updates. Builds and tests on Linux;
    apps/HVTradingBot.Android only adds the foreground service and the WebView.
  -->
  <ItemGroup>
    <ProjectReference Include="..\HVTradingBot.Hosting\HVTradingBot.Hosting.csproj" />
    <ProjectReference Include="..\HVTradingBot.Dashboard\HVTradingBot.Dashboard.csproj" />
    <ProjectReference Include="..\HVTradingBot.Infrastructure.Sqlite\HVTradingBot.Infrastructure.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Android apps have no configuration files next to the binary; the settings travel inside the assembly. -->
    <EmbeddedResource Include="..\HVTradingBot.Infrastructure\hvtradingbot.shared.json" LogicalName="hvtradingbot.shared.json" />
    <EmbeddedResource Include="hvtradingbot.mobile.json" LogicalName="hvtradingbot.mobile.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HVTradingBot.Mobile.Tests" />
  </ItemGroup>

</Project>
