<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the Android app runs, without any Android dependency: the trading engine (restarted when it stops), the
    dashboard's reads and actions behind an in-process request router, and live updates. Builds and tests on Linux;
    apps/Ospreya.Android only adds the foreground service and the WebView.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Ospreya.Hosting\Ospreya.Hosting.csproj" />
    <ProjectReference Include="..\Ospreya.Dashboard\Ospreya.Dashboard.csproj" />
    <ProjectReference Include="..\Ospreya.Infrastructure.Sqlite\Ospreya.Infrastructure.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Android apps have no configuration files next to the binary; the settings travel inside the assembly. -->
    <EmbeddedResource Include="..\Ospreya.Infrastructure\ospreya.shared.json" LogicalName="ospreya.shared.json" />
    <EmbeddedResource Include="ospreya.mobile.json" LogicalName="ospreya.mobile.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ospreya.Mobile.Tests" />
  </ItemGroup>

</Project>
