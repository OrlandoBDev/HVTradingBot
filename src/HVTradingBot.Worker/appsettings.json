{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Service} {CorrelationId} {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": { "path": "logs/worker-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
      }
    ]
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "SmtpHost": "smtp.gmail.com",
      "SmtpPort": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "HVTradingBot",
      "ToAddresses": [],
      "SubjectPrefix": "[HVTradingBot]",
      "NotifyOnStatuses": [ "RejectedByRisk", "ApprovalRequired", "Approved", "Executed" ],
      "MaxSendAttempts": 3
    }
  }
}
