<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS app (Mac Catalyst). Not part of HVTradingBot.sln: it needs the `maui` workload and Xcode, so it only builds on
    a Mac (and in the macos-latest CI job). All logic lives in src/HVTradingBot.App.Core; this project is pages only.
    Build/install: ./build-app.sh
  -->

  <PropertyGroup>
    <!-- Singular TargetFramework overrides the net10.0 from Directory.Build.props. -->
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>HVTradingBot.App</RootNamespace>
    <!-- Bundle HVTradingBot.app with executable HVTradingBot (does not match the native API/worker conflict check). -->
    <AssemblyName>HVTradingBot</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Warnings from the MAUI/Xcode toolchain vary with the installed Xcode; do not fail the build on them. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <ApplicationTitle>HVTradingBot</ApplicationTitle>
    <ApplicationId>com.hvtradingbot.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!--
      Not distributed through the App Store: build-app.sh ad-hoc signs the bundle with Platforms/MacCatalyst/Entitlements.plist
      (App Sandbox off, because the app runs `docker`). The build itself does not sign, so no certificate is needed.
    -->
    <EnableCodeSigning>false</EnableCodeSigning>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- One .app that runs on Apple Silicon and Intel Macs. -->
    <RuntimeIdentifiers>maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F172A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F172A" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HVTradingBot.App.Core\HVTradingBot.App.Core.csproj" />
  </ItemGroup>

</Project>
