<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HVTradingBot.App.ViewModels"
             x:Class="HVTradingBot.App.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             NavigationPage.HasNavigationBar="False"
             Title="HVTradingBot">

    <Grid RowDefinitions="*,Auto">

        <!-- The React dashboard served by the api container (same origin, so login cookie and SignalR work). -->
        <WebView x:Name="Dashboard" Grid.Row="0" />

        <!-- Status bar: worker state from /health/ready, polled every 15 s, and the stack controls. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="12,6" BackgroundColor="#0F172A">
            <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="6"
                     Color="{Binding StatusColor}" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding StatusText}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                <Label Text="{Binding StatusDetail}" TextColor="#94A3B8" FontSize="11" LineBreakMode="TailTruncation" />
                <Label Text="{Binding ActionMessage}" TextColor="#F59E0B" FontSize="11" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" />
                <Button Text="Stop trading" Command="{Binding StopTradingCommand}" BackgroundColor="#B91C1C" TextColor="White" />
                <Button Text="Start" Command="{Binding StartCommand}" />
                <Button Text="Restart worker" Command="{Binding RestartWorkerCommand}" />
                <Button Text="Logs" Command="{Binding LogsCommand}" />
                <Button Text="Open in browser" Command="{Binding OpenInBrowserCommand}" />
                <Button Text="Settings" Command="{Binding SettingsCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
