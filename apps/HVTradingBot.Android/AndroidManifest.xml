<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Deriv prices and orders, optional email. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Keep trading in the background with the screen off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Start again after the phone restarts. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Trade and status notifications (asked for at first start on Android 13+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
      android:label="HVTradingBot"
      android:icon="@drawable/ic_launcher"
      android:roundIcon="@drawable/ic_launcher"
      android:allowBackup="false"
      android:supportsRtl="true">

    <!--
      The trading engine. "specialUse": an automated trading engine that must keep evaluating markets and managing
      open positions around the clock is none of Android's predefined foreground service types.
    -->
    <service
        android:name="com.hvtradingbot.android.TradingService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Runs the user's automated trading engine continuously: evaluates markets every five minutes and manages open demo-account positions." />
    </service>

    <receiver
        android:name="com.hvtradingbot.android.BootReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
